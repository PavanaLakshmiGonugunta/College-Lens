# Database Connection String
# Replace user, password, host, port, and dbname with your local or remote PostgreSQL details
DATABASE_URL="postgresql://user:password@localhost:5432/collegelens?schema=public"

# NextAuth Secret
# You can generate a strong secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-string-here"

# NextAuth URL
# The base URL of your application (e.g., http://localhost:3000 for local development)
NEXTAUTH_URL="http://localhost:3000"
